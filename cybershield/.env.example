# ============================================================
#  CyberShield Bot — Environment Configuration
# ============================================================
#
# HOW TO SET YOUR BOT_TOKEN:
#
# Option A (Replit — recommended):
#   1. Click the "Secrets" tab (padlock icon) in the left sidebar
#   2. Add a new secret with key:   BOT_TOKEN
#                         value:  <your token from @BotFather>
#
# Option B (local development):
#   1. Copy this file:  cp .env.example .env
#   2. Paste your token below and save
#
# GET YOUR TOKEN:
#   1. Open Telegram and search for @BotFather
#   2. Send /newbot and follow the prompts
#   3. Copy the token it gives you (looks like: 123456789:ABCdef...)
#
# ============================================================

BOT_TOKEN=PASTE_YOUR_TOKEN_HERE
